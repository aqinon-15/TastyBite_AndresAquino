<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.ae.controller.LoginController" 
      alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="350.0">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="TastyBite Restaurant" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Inicio de Sesión" style="-fx-font-size: 14px;"/>
    
    <TextField fx:id="txtUsername" promptText="Usuario"/>
    <PasswordField fx:id="txtPassword" promptText="Contraseña"/>
    
    <Button text="Ingresar al Sistema" onAction="#handleLogin" prefWidth="200.0" 
            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
</VBox>